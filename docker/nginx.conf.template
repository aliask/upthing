server {
    listen 80;
    server_name localhost;
    index index.php index.html;
    root /var/www/public;

    location / {
        # try serving files directly, fallback to index.php
        try_files $uri /index.php$is_args$args;
    }

    # Re-resolve the upstream at request time so an app container restart
    # doesn't strand us on a dead address. Requires a variable in
    # fastcgi_pass; a literal hostname is only resolved at startup.
    #
    # The address is filled in at container start from resolv.conf, because
    # it differs by runtime - Docker uses 127.0.0.11, podman's netavark does
    # not. See docker/10-resolver.envsh.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    location ~ \.php$ {
        try_files $uri /index.php /index.php?q=$uri&$args =404;
        #fastcgi_split_path_info ^(.+\.php)(/.+)$;
        set $upstream_app upthing-app;
        fastcgi_pass $upstream_app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        #fastcgi_param PATH_INFO $fastcgi_path_info;

        #fastcgi_param DOCUMENT_ROOT $realpath_root;
        #internal;
    }

    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
}
